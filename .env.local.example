# Base URL for the API client. Consumed by src/api/axiosInstance.ts.
# Exposed to the browser, so it must be prefixed with NEXT_PUBLIC_.
# Also the base URL for the Consenti cookie widget (src/components/consent): it
# calls <this>/consenti/api/v1/* directly, matching the generated API client.
# Leave empty to keep every request same-origin (frontend and backend on one host).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server mode flag: "development" or "production". Read in next.config.mjs to
# gate dev-only behaviour. Defaults to NODE_ENV (next dev -> development,
# next build/start -> production); set it here only to override.
APP_ENV=development

# Dev only. Comma-separated hostnames allowed to load the Next dev server's
# cross-origin resources (/_next/* chunks, HMR WebSocket). Hostnames only —
# scheme/port/path are ignored. Leave empty to keep the permissive default
# (nothing blocked). Setting any value switches the dev server to allowlist
# mode. Wildcards match sub-domains only (e.g. *.trycloudflare.com), not IPs.
# Example: 127.0.0.1,192.168.1.20,*.trycloudflare.com
DEV_ALLOWED_ORIGINS=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Consumed by
# src/analytics/googleAnalytics.ts. Exposed to the browser, so it must be
# prefixed with NEXT_PUBLIC_. Leave empty to disable analytics entirely.
# Analytics load only on public pages (never on /internal/*, including the
# login page) and only after the visitor accepts the "analytics" cookie
# category in the consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
